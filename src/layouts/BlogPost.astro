---
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import { readingTime, tagSlug, type Post } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, draft, writtenBy, reviewedBy } = post.data;
---

<BaseLayout title={title} description={description} image={heroImage} type="article">
	<article>
		<header>
			{draft && <p class="draft">Brouillon : cet article n'est pas publié.</p>}
			<p class="meta muted">
				<FormattedDate date={pubDate} /> · {readingTime(post.body)} min de lecture
				{updatedDate && (
					<>
						{' '}· mis à jour le <FormattedDate date={updatedDate} />
					</>
				)}
			</p>
			<h1>{title}</h1>
			<p class="lede">{description}</p>
			{tags.length > 0 && (
				<p class="tags">
					{tags.map((tag) => <a class="tag" href={`/tags/${tagSlug(tag)}/`}>{tag}</a>)}
				</p>
			)}
		</header>

		{heroImage && <Image class="hero" src={heroImage} alt="" width={1200} height={630} loading="eager" />}

		<div class="prose">
			<slot />
		</div>

		<footer class="credits muted">
			Rédigé par <strong>{writtenBy}</strong>
			{reviewedBy.length > 0 && <> · vérifié par {reviewedBy.join(', ')}</>}
			· <a href="/blog">tous les articles</a>
		</footer>
	</article>
</BaseLayout>

<style>
	header {
		margin-bottom: 2rem;
	}
	.meta {
		font-size: 0.9rem;
		margin: 0 0 0.6rem;
	}
	.lede {
		font-size: 1.15rem;
		color: var(--fg-muted);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.hero {
		width: 100%;
		margin-bottom: 2rem;
	}
	.draft {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: #b26a00;
		border: 1px dashed currentColor;
		border-radius: var(--radius);
		padding: 0.5rem 0.8rem;
	}
	.prose :global(h2) {
		padding-top: 0.5rem;
	}
	.credits {
		margin-top: 3rem;
		padding-top: 1.2rem;
		border-top: 1px solid var(--border);
		font-size: 0.9rem;
	}
</style>
