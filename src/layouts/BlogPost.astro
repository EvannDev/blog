---
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import Ornament from '../components/Ornament.astro';
import TagList from '../components/TagList.astro';
import { readingTime, type Post } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, draft, writtenBy, reviewedBy } = post.data;
---

<BaseLayout title={title} description={description} image={heroImage} type="article">
	<article>
		<header class="post-head">
			<div class="cb-ornaments" aria-hidden="true">
				<Ornament kind="terminal" size={110} style="left: -6%; top: 14%; --r: -10deg" />
				<Ornament kind="branch" size={64} style="right: 1%; top: 6%; --r: 14deg" />
			</div>
			<div class="post-head__content">
				{draft && <p class="cb-tag cb-fill-peach">Brouillon : cet article n'est pas publié</p>}
				{tags.length > 0 && <TagList tags={tags.map((tag) => ({ tag }))} />}
				<h1 class="cb-display cb-display--article">{title}</h1>
				<p class="cb-lede cb-lede--muted">{description}</p>
				<p class="byline">
					<span class="cb-avatar">
						<span class="cb-avatar__disc" aria-hidden="true">{writtenBy.charAt(0).toUpperCase()}</span>
						<span>{writtenBy}</span>
					</span>
					<span class="cb-tag cb-fill-white">
						<FormattedDate date={pubDate} /> · {readingTime(post.body)} min de lecture
					</span>
					{
						updatedDate && (
							<span class="cb-tag cb-fill-white">
								mis à jour le <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</p>
			</div>
		</header>

		<div class="cb-sheet">
			{heroImage && <Image class="hero" src={heroImage} alt="" width={1200} height={630} loading="eager" />}
			<div class="cb-prose">
				<slot />
			</div>
		</div>

		<footer class="post-foot">
			<p class="cb-tag cb-tag--lg cb-fill-white credits">
				<span>Rédigé par <strong>{writtenBy}</strong>{reviewedBy.length > 0 && <> · vérifié par {reviewedBy.join(', ')}</>}</span>
			</p>
			<a class="cb-btn" href="/blog">← Tous les articles</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.post-head {
		position: relative;
		max-width: 940px;
		margin: 0 auto;
		padding: clamp(40px, 7vw, 96px) 0 var(--space-7);
		text-align: center;
	}
	.post-head__content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 28px;
	}
	.post-head__content :global(.cb-tags) {
		justify-content: center;
	}
	.post-head .cb-lede {
		max-width: 620px;
		margin: 0;
	}
	.post-head p.cb-tag {
		margin: 0;
	}
	.byline {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: var(--space-3) var(--space-4);
	}
	.hero {
		display: block;
		width: 100%;
		margin: 0 auto var(--space-7);
		border: var(--stroke) solid var(--line);
		border-radius: var(--radius-md);
	}
	.post-foot {
		max-width: var(--size-sheet);
		margin: var(--space-6) auto 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-4);
	}
	.credits {
		margin: 0;
		box-shadow: none;
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 16px;
		white-space: normal;
	}
	.credits strong {
		font-weight: 700;
	}
</style>
