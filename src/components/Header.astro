---
import Ornament from './Ornament.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
	{ href: '/blog', label: 'Articles' },
	{ href: '/tags', label: 'Sujets' },
	{ href: '/a-propos', label: 'À propos' },
	{ href: '/rss.xml', label: 'RSS' },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="cb-page">
	<div class="cb-header">
		<a class="cb-brand" href="/" aria-label="Accueil · Carnet de bord" title="Carnet de bord"><Ornament kind="cluster" size={32} /></a>
		<nav aria-label="Navigation principale">
			<ul class="cb-nav">
				{
					links.map(({ href, label }) => (
						<li>
							<a href={href} aria-current={isActive(href) ? 'page' : undefined}>
								{label}
							</a>
						</li>
					))
				}
				<li>
					<button id="theme-toggle" class="cb-theme" type="button" aria-label="Basculer le thème clair / sombre">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<circle cx="12" cy="12" r="8"></circle>
							<path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
						</svg>
					</button>
				</li>
			</ul>
		</nav>
	</div>
</header>

<script>
	const button = document.getElementById('theme-toggle');
	button?.addEventListener('click', () => {
		const root = document.documentElement;
		const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		const next = current === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});
</script>

<style>
	.cb-header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-3) var(--space-5);
		padding: var(--space-5) 0;
	}
	/* Marque : pastille ronde avec le cluster, sans texte (le nom est porté par aria-label) */
	.cb-brand {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--size-tap-lg);
		height: var(--size-tap-lg);
		border: var(--stroke) solid var(--line);
		border-radius: var(--radius-round);
		background: var(--surface);
		box-shadow: var(--shadow-md);
		transition: transform 0.12s ease, box-shadow 0.12s ease;
	}
	.cb-brand:hover {
		transform: translate(-1px, -1px);
		box-shadow: var(--shadow-lg);
	}
	@media (prefers-reduced-motion: reduce) {
		.cb-brand {
			transition: none;
		}
		.cb-brand:hover {
			transform: none;
		}
	}
	.cb-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		align-items: center;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.cb-nav a,
	.cb-nav button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: var(--size-tap);
		padding: 0 18px;
		border: var(--stroke) solid var(--line);
		border-radius: var(--radius-pill);
		background: var(--surface);
		color: var(--ink);
		font-family: var(--font-ui);
		font-weight: 600;
		font-size: 15px;
		line-height: 1.2;
		letter-spacing: 0.02em;
		text-decoration: none;
		cursor: pointer;
	}
	.cb-nav a:hover,
	.cb-nav button:hover {
		box-shadow: var(--shadow-sm);
	}
	.cb-nav a[aria-current='page'] {
		background: var(--butter);
		color: var(--on-fill);
		box-shadow: var(--shadow-md);
	}
	.cb-nav .cb-theme {
		width: var(--size-tap);
		padding: 0;
		border-radius: var(--radius-round);
	}
</style>
