---
// Stickers « infra » du design system : décor uniquement (aria-hidden), jamais dans le texte.
// Contour on-fill (charbon dans les deux thèmes) ; les traits posés sur le fond (o-ground) suivent --line.
// Chaque sticker a une petite animation interne (désactivée sous prefers-reduced-motion, voir global.css).
type Kind = 'pod' | 'container' | 'cluster' | 'board' | 'terminal' | 'branch' | 'rack' | 'manifest';

interface Props {
	kind: Kind;
	/** Largeur en px ; la hauteur suit le format du sticker. */
	size?: number;
	class?: string;
	style?: string;
}

const { kind, size = 96, class: className, style } = Astro.props;
const wide = kind === 'pod' || kind === 'container' || kind === 'board' || kind === 'terminal';
const viewBox = wide ? '0 0 80 60' : '0 0 60 60';
const height = wide ? Math.round((size * 60) / 80) : size;
const ribs = [16, 24, 32, 40, 48, 56, 64];
const pins = [19, 25, 31, 37, 43, 49];
---

<svg
	class:list={['cb-ornament', `cb-ornament--${kind}`, className]}
	width={size}
	height={height}
	viewBox={viewBox}
	aria-hidden="true"
	focusable="false"
	style={style}
>
	{
		kind === 'pod' && (
			<>
				<path class="o-line o-mint" d="M6 36 C 16 14, 54 10, 74 22 C 62 46, 24 52, 6 36 Z" stroke-width="2.4" stroke-linejoin="round" />
				<path class="o-line o-white" d="M14 34 C 26 22, 52 19, 66 25 C 56 38, 28 42, 14 34 Z" stroke-width="2" />
				<circle class="o-line o-mint o-pea" cx="27" cy="32" r="5.5" stroke-width="2" style="--k: 0" />
				<circle class="o-line o-mint o-pea" cx="40" cy="30" r="6" stroke-width="2" style="--k: 1" />
				<circle class="o-line o-mint o-pea" cx="53" cy="28" r="5.5" stroke-width="2" style="--k: 2" />
				<path class="o-ground" d="M74 22 C 78 17, 77 12, 72 9" fill="none" stroke-width="2.4" stroke-linecap="round" />
			</>
		)
	}
	{
		kind === 'container' && (
			<>
				<rect class="o-line o-sky" x="6" y="14" width="68" height="34" rx="4" stroke-width="2.4" />
				<g class="o-line" stroke-width="2" stroke-linecap="round">
					{ribs.map((x) => <line x1={x} y1="21" x2={x} y2="41" />)}
				</g>
				<rect class="o-line o-butter" x="4" y="12" width="9" height="7" rx="2" stroke-width="2" />
				<rect class="o-line o-butter" x="67" y="12" width="9" height="7" rx="2" stroke-width="2" />
				<rect class="o-line o-butter" x="4" y="43" width="9" height="7" rx="2" stroke-width="2" />
				<rect class="o-line o-butter" x="67" y="43" width="9" height="7" rx="2" stroke-width="2" />
			</>
		)
	}
	{
		kind === 'cluster' && (
			<>
				<path class="o-ground" d="M30 13 L12 44 L48 44 Z" fill="none" stroke-width="2.4" stroke-linejoin="round" />
				<g class="o-node" style="--k: 0">
					<circle class="o-line o-butter" cx="30" cy="13" r="9" stroke-width="2.4" />
					<circle class="o-ink" cx="30" cy="13" r="2.6" />
				</g>
				<g class="o-node" style="--k: 1">
					<circle class="o-line o-coral" cx="12" cy="44" r="9" stroke-width="2.4" />
					<circle class="o-ink" cx="12" cy="44" r="2.6" />
				</g>
				<g class="o-node" style="--k: 2">
					<circle class="o-line o-lavender" cx="48" cy="44" r="9" stroke-width="2.4" />
					<circle class="o-ink" cx="48" cy="44" r="2.6" />
				</g>
			</>
		)
	}
	{
		kind === 'board' && (
			<>
				<rect class="o-line o-turquoise" x="6" y="10" width="68" height="42" rx="6" stroke-width="2.4" />
				<rect class="o-line o-butter" x="14" y="14" width="40" height="7" rx="2" stroke-width="2" />
				<g class="o-ink">{pins.map((x) => <circle cx={x} cy="17.5" r="1.2" />)}</g>
				<rect class="o-line o-white" x="20" y="27" width="17" height="17" rx="3" stroke-width="2" />
				<rect class="o-line o-white" x="62" y="25" width="15" height="10" rx="2" stroke-width="2" />
				<rect class="o-line o-white" x="62" y="38" width="15" height="9" rx="2" stroke-width="2" />
				<circle class="o-line o-coral o-led" cx="45" cy="44" r="2.6" stroke-width="1.6" />
			</>
		)
	}
	{
		kind === 'terminal' && (
			<>
				<rect class="o-line o-white" x="6" y="8" width="68" height="46" rx="8" stroke-width="2.4" />
				<path class="o-line o-lavender" d="M14 8 H66 A8 8 0 0 1 74 16 V20 H6 V16 A8 8 0 0 1 14 8 Z" stroke-width="2.4" stroke-linejoin="round" />
				<circle class="o-line o-coral" cx="14" cy="14" r="2.4" stroke-width="1.4" />
				<circle class="o-line o-butter" cx="21" cy="14" r="2.4" stroke-width="1.4" />
				<circle class="o-line o-mint" cx="28" cy="14" r="2.4" stroke-width="1.4" />
				<path class="o-line" d="M16 29 L24 35 L16 41" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
				<rect class="o-ink o-cursor" x="30" y="39" width="14" height="4" rx="1.5" />
			</>
		)
	}
	{
		kind === 'branch' && (
			<>
				<line class="o-ground" x1="18" y1="10" x2="18" y2="50" stroke-width="3" stroke-linecap="round" />
				<path class="o-ground" d="M18 40 C 18 28, 42 30, 42 16" fill="none" stroke-width="3" stroke-linecap="round" />
				<circle class="o-line o-butter" cx="18" cy="10" r="6" stroke-width="2.4" />
				<circle class="o-line o-white" cx="18" cy="30" r="5" stroke-width="2.4" />
				<circle class="o-line o-butter" cx="18" cy="50" r="6" stroke-width="2.4" />
				<circle class="o-line o-coral o-commit" cx="42" cy="14" r="6" stroke-width="2.4" />
			</>
		)
	}
	{
		kind === 'rack' && (
			<>
				{[6, 23, 40].map((y, k) => (
					<>
						<rect class="o-line o-peach" x="10" y={y} width="40" height="14" rx="4" stroke-width="2.4" />
						<circle class="o-line o-mint o-blink" cx="17" cy={y + 7} r="2.4" stroke-width="1.4" style={`--k: ${k}`} />
						<line class="o-line" x1="28" y1={y + 7} x2="43" y2={y + 7} stroke-width="2.4" stroke-linecap="round" />
					</>
				))}
			</>
		)
	}
	{
		kind === 'manifest' && (
			<>
				<path class="o-line o-white" d="M12 4 H38 L50 16 V56 H12 Z" stroke-width="2.4" stroke-linejoin="round" />
				<path class="o-line o-butter" d="M38 4 V16 H50 Z" stroke-width="2.4" stroke-linejoin="round" />
				<line class="o-line o-write" x1="18" y1="24" x2="32" y2="24" stroke-width="3.2" stroke-linecap="round" style="--k: 0" />
				<line class="o-stroke-lavender o-write" x1="24" y1="32" x2="43" y2="32" stroke-width="3.2" stroke-linecap="round" style="--k: 1" />
				<line class="o-stroke-lavender o-write" x1="24" y1="40" x2="37" y2="40" stroke-width="3.2" stroke-linecap="round" style="--k: 2" />
				<line class="o-line o-write" x1="18" y1="48" x2="30" y2="48" stroke-width="3.2" stroke-linecap="round" style="--k: 3" />
			</>
		)
	}
</svg>
