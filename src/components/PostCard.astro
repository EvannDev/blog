---
import { markerTone, readingTime, type Post } from '../lib/posts';

interface Props {
	post: Post;
	/** Numéro de l'article dans le carnet (1 = le plus ancien). */
	number: number;
	headingLevel?: 'h2' | 'h3';
}

const { post, number, headingLevel = 'h3' } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
const Heading = headingLevel;
const date = pubDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<a class="cb-card" href={`/blog/${post.id}/`}>
	<span class={`cb-marker cb-fill-${markerTone(number)}`} aria-hidden="true">{number}</span>
	<Heading class="cb-card__title">{title}</Heading>
	<p class="cb-card__desc">{description}</p>
	<p class="cb-card__meta">
		<time datetime={pubDate.toISOString()}>{date}</time> · {readingTime(post.body)} min{tags.length > 0 && ` · ${tags.join(', ')}`}
		{draft && <span class="cb-tag cb-fill-peach draft">brouillon</span>}
	</p>
</a>

<style>
	.draft {
		margin-left: var(--space-2);
		padding: 2px 10px;
		font-size: 13px;
	}
</style>
