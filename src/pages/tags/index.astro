---
import Ornament from '../../components/Ornament.astro';
import TagList from '../../components/TagList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags } from '../../lib/posts';

const tags = getTags(await getPosts());
---

<BaseLayout title="Sujets" description="Les sujets abordés sur le carnet de bord du homelab.">
	<header class="page-head">
		<h1 class="cb-display cb-display--page">Sujets</h1>
		<p class="cb-lede cb-lede--muted">Chaque sujet regroupe les articles qui en parlent. Le chiffre, c'est leur nombre.</p>
	</header>
	{
		tags.length === 0 ? (
			<p class="cb-lede cb-lede--muted">Aucun sujet pour l'instant.</p>
		) : (
			<section class="cb-band" aria-label="Tous les sujets">
				<div class="cb-ornaments" aria-hidden="true">
					<Ornament kind="container" size={104} style="right: 24px; top: -44px; --r: 10deg" />
				</div>
				<TagList tags={tags} size="lg" white />
			</section>
		)
	}
</BaseLayout>

<style>
	.page-head {
		padding: clamp(40px, 6vw, 80px) 0 var(--space-7);
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}
	.page-head .cb-lede {
		margin: 0;
	}
</style>
