// Dépendances du blog (npm, image de base, actions GitHub).
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Actions GitHub et images de base épinglées par digest (chaîne d'approvisionnement)
  extends: ['config:recommended', ':dependencyDashboard', 'helpers:pinGitHubActionDigests', 'docker:pinDigests'],
  timezone: 'Europe/Paris',
  schedule: ['* 6-12 * * 6'],
  minimumReleaseAge: '3 days',
  labels: ['dependencies'],
  packageRules: [
    {
      // Mineures et patchs : fusion automatique si la CI (build du site + image) passe
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
    },
  ],
}
